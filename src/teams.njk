---
layout: base.njk
title: Teams
description: "Find the right Livermore Lions youth rugby age group for your child."
---

<section class="policy-hero">
  <div class="policy-wrap">
    <h1>Find your team</h1>
    <p>Every Lion starts somewhere. Find the right age group for your child and get started with Livermore Lions.</p>
  </div>
</section>

<section id="teams">
  <div class="wrap">
    <div class="team-grid">

      {% for team in teams.list %}
      <div class="team-card">

        <div class="team-card-top"></div>

        <div class="team-card-body">
          <div class="team-tag">{{ team.tag }}</div>

          <h3>{{ team.name }}</h3>

          <p>{{ team.description }}</p>

          <a class="btn btn-maroon" href="{{ team.linkUrl }}">
            {{ team.linkLabel }}
          </a>
        </div>

      </div>
      {% endfor %}

    </div>
  </div>
</section>
